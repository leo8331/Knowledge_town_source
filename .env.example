# Local backend only. Never put API keys in dist/ or commit .env.
API_BASE_URL=
API_MODEL=
API_KEY=
PORT=8766
API_JSON_MODE=true
API_CHUNK_CHARS=12000
API_MAX_CHUNKS=40
API_MAX_OUTPUT_TOKENS=6000
# Select max_tokens or max_completion_tokens for your provider/model.
API_TOKEN_PARAMETER=max_tokens
API_TIMEOUT_MS=90000

# Optional image generation. Falls back to the text API settings when blank.
IMAGE_API_BASE_URL=
IMAGE_API_MODEL=gpt-image-1
IMAGE_API_KEY=

# ── 部署模式（本地不用改，放到公网才需要）──
# 1 = 接受公网域名；不设时只服务 127.0.0.1 / localhost
TOWN_PUBLIC=
# 监听地址。公网部署用 0.0.0.0；本机留空即 127.0.0.1
HOST=
# 可选域名白名单，逗号分隔，如 town.example.com。留空表示接受任意域名
TOWN_PUBLIC_HOSTS=
# 公网模式下花钱接口的限额（每 IP 每 10 分钟次数），默认 5
TOWN_RATE_LIMIT=
# 可选：把模型配置存到容器外（挂盘后设置），如 /data/model-profiles.json
TOWN_PROFILE_FILE=
# 可选：出题器题库与配置目录，如 /data/kb
KB_DATA_DIR=
